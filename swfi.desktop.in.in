[Desktop Entry]
Name=Swfi
GenericName=Image Viewer
Comment=A simple image viewer for SwordFish
Keywords=image viewer;image manager
Exec=swfi %f
Terminal=false
Type=Application
StartupNotify=@STARTUPNOTIFY@
MimeType=image/bmp;image/jpeg;image/gif;image/png;image/tiff;image/xpm;
Icon=swordfish-image
Categories=Utility;Viewer;

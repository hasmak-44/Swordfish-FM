[Desktop Entry]
Name=Swfp
GenericName=Package Manager
Comment=A simple package manager for SwordFish
Keywords=package viewer;package manager
Exec=swfp %f
Terminal=false
Type=Application
StartupNotify=@STARTUPNOTIFY@
MimeType=application/x-deb;application/x-debian-package;application/x-rpm;
Icon=swordfish-package
Categories=Utility;PackageManager;

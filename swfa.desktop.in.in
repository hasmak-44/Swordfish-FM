[Desktop Entry]
Name=Swfa
GenericName=Archive viewer
Comment=A simple archive viewer and extractor for SwordFish
Keywords=archive viewer;archive extractor
Exec=swfa %F
Terminal=false
Type=Application
StartupNotify=@STARTUPNOTIFY@

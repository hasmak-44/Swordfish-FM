#!/bin/bash
set -e
echo "=== Swordfish-FM uninstall (uninstall-xfe) ==="

echo "[*] Removing binaries..."
sudo rm -f /usr/bin/swordfish
sudo rm -f /usr/bin/xfe
sudo rm -f /usr/local/bin/swordfish
sudo rm -f /usr/local/bin/xfe
sudo make uninstall 2>/dev/null || true

echo "[*] Removing launchers..."
sudo rm -f /usr/share/applications/swordfish.desktop
sudo rm -f /usr/share/applications/xfe.desktop
sudo rm -f /usr/share/applications/org.xfe.xfe.desktop
rm -f ~/.local/share/applications/swordfish.desktop
rm -f ~/.local/share/applications/xfe.desktop

echo "[*] Removing leftover settings - the main fix..."
rm -rf ~/.config/xfe
rm -rf ~/.config/swordfish
rm -rf ~/.xfe
rm -rf ~/.swordfish
rm -rf ~/.local/share/xfe
rm -rf ~/.local/share/swordfish
rm -f ~/.config/xferc
rm -f ~/.xferc

echo "[*] Updating icon cache..."
sudo update-desktop-database -q 2>/dev/null || true
sudo gtk-update-icon-cache -f /usr/share/icons/hicolor -q 2>/dev/null || true

echo "=== Uninstall complete - no leftovers ==="
ls -l /usr/bin/swordfish 2>&1 | echo "checked binary removed"
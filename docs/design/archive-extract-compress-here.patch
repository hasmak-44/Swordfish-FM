+// Archive kinds, from the file name
+enum
+{
+    ARCHIVE_NONE,
+    ARCHIVE_TAR,      // tar, possibly compressed (tar.gz, tgz...)
+    ARCHIVE_STREAM,   // A single compressed file (gz, xz...)
+    ARCHIVE_ZIP,
+    ARCHIVE_7Z,
+    ARCHIVE_RAR,
+    ARCHIVE_OTHER     // iso, cab, cpio, lzh, ace, arj
+};
+
+static int xf_archivekind(const FXString& path)
+{
+    FXString name = FXPath::name(path).lower();
+    FXString ext1 = name.rafter('.', 1);
+    FXString ext2 = name.rafter('.', 2);
+    if (name.find('.') < 0)
+    {
+        return ARCHIVE_NONE;
+    }
+    if (ext2.left(4) == "tar." || ext1 == "tar" || ext1 == "tgz" || ext1 == "tbz" || ext1 == "tbz2" ||
+        ext1 == "txz" || ext1 == "tzst" || ext1 == "taz")
+    {
+        return ARCHIVE_TAR;
+    }
+    if (ext1 == "gz" || ext1 == "bz2" || ext1 == "xz" || ext1 == "zst" || ext1 == "z" || ext1 == "lzma")
+    {
+        return ARCHIVE_STREAM;
+    }
+    if (ext1 == "zip")
+    {
+        return ARCHIVE_ZIP;
+    }
+    if (ext1 == "7z")
+    {
+        return ARCHIVE_7Z;
+    }
+    if (ext1 == "rar")
+    {
+        return ARCHIVE_RAR;
+    }
+    if (ext1 == "iso" || ext1 == "cab" || ext1 == "cpio" || ext1 == "lzh" || ext1 == "ace" || ext1 == "arj")
+    {
+        return ARCHIVE_OTHER;
+    }
+    return ARCHIVE_NONE;
+}
+
+
+FXbool xf_isarchive(const FXString& path)
+{
+    return xf_archivekind(path) != ARCHIVE_NONE && xf_isfile(path);
+}
+
+
+// First of the given programs found in the PATH, or empty
+static FXString xf_firstcommand(const char* const* programs)
+{
+    for (int i = 0; programs[i]; i++)
+    {
+        if (xf_existcommand(programs[i]))
+        {
+            return programs[i];
+        }
+    }
+    return FXString::null;
+}
+
+static const char* const sevenzip[] = { "7zz", "7z", "7za", NULL };
+
+
+// Name of the file or folder an archive extracts to: archive name without its archive extension
+FXString xf_archivebasename(const FXString& path)
+{
+    FXString name = FXPath::name(path);
+    FXString base = name.lower().rafter('.', 2).left(4) == "tar." ? name.rbefore('.', 2) : name.rbefore('.', 1);
+    return base.empty() ? name : base;
+}
+
+
+// Command extracting an archive into the current folder. A single compressed file is written as output.
+// Returns an empty string if no suitable program is installed.
+FXString xf_extractcommand(const FXString& archive, const FXString& output)
+{
+    FXString q = xf_quote(archive);
+    FXString name = FXPath::name(archive).lower();
+    FXString ext1 = name.rafter('.', 1);
+    FXString prog;
+
+    switch (xf_archivekind(archive))
+    {
+    case ARCHIVE_TAR:
+        return "tar -xvf " + q;
+
+    case ARCHIVE_STREAM:
+    {
+        const char* decompressor = (ext1 == "bz2") ? "bzip2" : (ext1 == "xz" || ext1 == "lzma") ? "xz" :
+                                   (ext1 == "zst") ? "zstd" : "gzip";
+        if (!xf_existcommand(decompressor))
+        {
+            return FXString::null;
+        }
+        return FXString(decompressor) + " -dc " + q + " > " + xf_quote(output);
+    }
+
+    case ARCHIVE_ZIP:
+        if (xf_existcommand("unzip"))
+        {
+            return "unzip -o " + q;
+        }
+        break;
+
+    case ARCHIVE_RAR:
+        if (xf_existcommand("unrar"))
+        {
+            return "unrar x -o+ " + q;
+        }
+        break;
+
+    case ARCHIVE_OTHER:
+        if (ext1 == "lzh" && xf_existcommand("lha"))
+        {
+            return "lha -xf " + q;
+        }
+        if (ext1 == "ace" && xf_existcommand("unace"))
+        {
+            return "unace x " + q;
+        }
+        if (ext1 == "arj" && xf_existcommand("arj"))
+        {
+            return "arj x -y " + q;
+        }
+        break;
+
+    default:
+        break;
+    }
+
+    // 7-Zip and libarchive read nearly every format, including RAR and ISO
+    prog = xf_firstcommand(sevenzip);
+    if (!prog.empty())
+    {
+        return prog + " x -y " + q;
+    }
+    if (xf_existcommand("bsdtar"))
+    {
+        return "bsdtar -xvf " + q;
+    }
+    return FXString::null;
+}
+
+
+static FXbool xf_parseulong(const FXString& token, FXulong& value)
+{
+    if (token.empty())
+    {
+        return false;
+    }
+    for (int i = 0; i < token.length(); i++)
+    {
+        if (!Ascii::isDigit(token[i]))
+        {
+            return false;
+        }
+    }
+    value = strtoull(token.text(), NULL, 10);
+    return true;
+}
+
+
+// Space needed to extract an archive. ZIP, 7z, RAR and ISO list their unpacked sizes cheaply, so the
+// size is exact. Compressed streams would have to be decompressed completely to be measured, so the
+// archive size is used as a lower bound. Returns false if the size is unknown.
+FXbool xf_archiveunpackedsize(const FXString& archive, FXulong& size, FXbool& exact)
+{
+    size = 0;
+    exact = false;
+    struct stat info;
+    if (stat(archive.text(), &info) != 0 || !S_ISREG(info.st_mode))
+    {
+        return false;
+    }
+    int kind = xf_archivekind(archive);
+    FXString ext1 = FXPath::name(archive).lower().rafter('.', 1);
+    if (kind == ARCHIVE_TAR || kind == ARCHIVE_STREAM)
+    {
+        size = info.st_size;
+        exact = (ext1 == "tar");
+        return true;
+    }
+
+    // Listing never asks for a password (no input) and can't hang on a damaged archive
+    FXString q = xf_quote(archive);
+    FXString output;
+    if (kind == ARCHIVE_ZIP && xf_existcommand("unzip") &&
+        xf_hostcommandoutput("timeout -k 1 30 unzip -Zt " + q + " </dev/null", output))
+    {
+        // 3 files, 12345 bytes uncompressed, 6789 bytes compressed:  45.0%
+        int pos = output.find(" bytes uncompressed");
+        int start = pos > 0 ? output.rfind(' ', pos - 1) + 1 : 0;
+        if (pos > 0 && xf_parseulong(output.mid(start, pos - start), size))
+        {
+            exact = true;
+            return true;
+        }
+    }
+
+    FXString prog = xf_firstcommand(sevenzip);
+    if (!prog.empty() && xf_hostcommandoutput("timeout -k 1 30 " + prog + " l " + q + " </dev/null", output))
+    {
+        // The summary follows the last dashed line: [date time] size packed N files[, N folders]
+        int dashes = output.rfind("\n------");
+        FXString summary = dashes >= 0 ? output.mid(dashes + 1, output.length()).after('\n').section('\n', 0) : "";
+        for (int i = 0; !summary.empty() && i < summary.contains(' ') + 1; i++)
+        {
+            FXString token = summary.section(' ', i);
+            if (!token.empty() && xf_parseulong(token, size))
+            {
+                exact = true;
+                return true;
+            }
+        }
+    }
+
+    if (xf_existcommand("bsdtar") && xf_hostcommandoutput("timeout -k 1 30 bsdtar -tvf " + q + " </dev/null", output))
+    {
+        // -rw-r--r--  0 owner  group  12345 Jan  1  2024 name
+        FXulong total = 0, entry;
+        for (int i = 0; i < output.contains('\n') + 1; i++)
+        {
+            FXString line = output.section('\n', i).simplify();
+            if (line[0] == '-' && xf_parseulong(line.section(' ', 4), entry))
+            {
+                total += entry;
+            }
+        }
+        size = total;
+        exact = true;
+        return true;
+    }
+    return false;
+}
+
+
+// Ask the file system to really allocate size bytes in dir, then release them. Unlike the free space
+// reported by statvfs, this also honours disk quotas and file systems that only estimate free space.
+// Returns 1 if the space could be allocated, 0 if it could not, -1 if the file system can't tell.
+int xf_reservespace(const FXString& dir, FXulong size)
+{
+    if (size == 0)
+    {
+        return 1;
+    }
+    FXString path = FXPath::absolute(dir, ".swordfish-reserve-XXXXXX");
+    std::vector<char> tmpl(path.text(), path.text() + path.length() + 1);
+    int fd = mkstemp(tmpl.data());
+    if (fd < 0)
+    {
+        return -1;
+    }
+    unlink(tmpl.data());
+    int ret = 1;
+    if (fallocate(fd, 0, 0, (off_t)size) != 0)
+    {
+        ret = (errno == ENOSPC || errno == EDQUOT || errno == EFBIG) ? 0 : -1;
+    }
+    close(fd);
+    return ret;
+}

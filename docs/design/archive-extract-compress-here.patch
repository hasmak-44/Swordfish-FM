+// Local file paths in a dropped uri-list
+std::vector<FXString> File::dropPaths(const FXuchar* data, FXuint len)
+{
+    std::vector<FXString> paths;
+    FXString list((const FXchar*)data, len);
+    for (int i = 0; i < list.contains('\n') + 1; i++)
+    {
+        FXString url = list.section('\n', i);
+        url.trim();
+        if (!url.empty())
+        {
+            paths.push_back(FXURL::decode(FXURL::fileFromURL(url)));
+        }
+    }
+    return paths;
+}
+
+
+FXbool File::allArchives(const std::vector<FXString>& paths)
+{
+    for (size_t i = 0; i < paths.size(); i++)
+    {
+        if (!xf_isarchive(paths[i]))
+        {
+            return false;
+        }
+    }
+    return !paths.empty();
+}

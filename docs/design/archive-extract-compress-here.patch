+// Compress items from one folder into an archive in another folder
+int File::compressInto(FXWindow* owner, const std::vector<FXString>& sources, const FXString& dir)
+{
+    if (sources.empty())
+    {
+        return 0;
+    }
+    FXString parent = FXPath::directory(sources[0]);
+    for (size_t i = 1; i < sources.size(); i++)
+    {
+        if (FXPath::directory(sources[i]) != parent)
+        {
+            MessageBox::warning(owner, BOX_OK, _("Compress Here"),
+                                _("Items from different folders can't be compressed together.\n"
+                                  "Drag items from one folder at a time."));
+            return 0;
+        }
+    }
+
+    FXString name = sources.size() == 1 ? FXPath::name(sources[0]) : FXPath::name(parent);
+    if (name.empty())
+    {
+        name = _("Archive");
+    }
+    ArchInputDialog dialog(owner, "");
+    dialog.create();
+    dialog.setText(FXPath::absolute(dir, name + ".tar.gz"));
+    dialog.CursorEnd();
+    if (!dialog.execute(PLACEMENT_OWNER))
+    {
+        return 0;
+    }
+    FXString archive = dialog.getText();
+    if (archive.empty())
+    {
+        MessageBox::warning(owner, BOX_OK, _("Warning"), _("File name is empty, operation cancelled"));
+        return 0;
+    }
+    archive = FXPath::absolute(dir, archive);
+    if (!xf_iswritable(FXPath::directory(archive)))
+    {
+        MessageBox::error(owner, BOX_OK, _("Error"), _("Can't write to %s: Permission denied"),
+                          FXPath::directory(archive).text());
+        return 0;
+    }
+
+    FXString lower = FXPath::name(archive).lower();
+    FXString ext1 = lower.rafter('.', 1);
+    FXString ext2 = lower.rafter('.', 2);
+    FXString qarchive = xf_quote(archive);
+    FXString items;
+    for (size_t i = 0; i < sources.size(); i++)
+    {
+        items += " " + xf_quote(FXPath::name(sources[i]));
+    }
+
+    FXString cmd;
+    if (ext2 == "tar.gz" || ext2 == "tar.bz2" || ext2 == "tar.xz" || ext2 == "tar.zst" || ext2 == "tar.z" ||
+        ext1 == "tgz" || ext1 == "tbz2" || ext1 == "tbz" || ext1 == "txz" || ext1 == "tzst" || ext1 == "taz")
+    {
+        cmd = "tar -acvf " + qarchive + items;
+    }
+    else if (ext1 == "tar")
+    {
+        cmd = "tar -cvf " + qarchive + items;
+    }
+    else if (ext1 == "zip")
+    {
+        cmd = "zip -r " + qarchive + items;
+    }
+    else if (ext1 == "7z")
+    {
+        FXString prog = xf_existcommand("7zz") ? "7zz" : xf_existcommand("7z") ? "7z" : "7za";
+        cmd = prog + " a " + qarchive + items;
+    }
+    else if (ext1 == "rar")
+    {
+        cmd = "rar a " + qarchive + items;
+    }
+    else if (ext1 == "gz" || ext1 == "bz2" || ext1 == "xz" || ext1 == "zst" || ext1 == "z")
+    {
+        // These compress one file; never compress in place, which would replace the original
+        if (sources.size() != 1 || !xf_isfile(sources[0]))
+        {
+            MessageBox::warning(owner, BOX_OK, _("Compress Here"),
+                                _("The .%s format compresses a single file.\n"
+                                  "Choose a format such as .tar.gz or .zip for folders or several items."),
+                                ext1.text());
+            return 0;
+        }
+        const char* prog = (ext1 == "bz2") ? "bzip2" : (ext1 == "xz") ? "xz" : (ext1 == "zst") ? "zstd" :
+                           (ext1 == "z") ? "compress" : "gzip";
+        cmd = FXString(prog) + " -c" + items + " > " + qarchive;
+    }
+    else
+    {
+        qarchive = xf_quote(archive + ".tar.gz");
+        cmd = "tar -acvf " + qarchive + items;
+    }
+
+    FXString currentdir = FXSystem::getCurrentDirectory();
+    if (chdir(parent.text()) != 0)
+    {
+        MessageBox::error(owner, BOX_OK, _("Error"), _("Can't enter folder %s: %s"), parent.text(), strerror(errno));
+        return 0;
+    }
+    File* f = new File(owner, _("Create archive"), ARCHIVE);
+    f->create();
+    int ret = f->archive(qarchive, cmd);
+    delete f;
+    if (chdir(currentdir.text()) != 0)
+    {
+        MessageBox::error(owner, BOX_OK, _("Error"), _("Can't enter folder %s: %s"), currentdir.text(),
+                          strerror(errno));
+    }
+    return ret;
+}

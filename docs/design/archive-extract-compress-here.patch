+// Extract an archive into a new folder named after it, so its files can't spill out or overwrite
+// anything. A single compressed file is decompressed beside it under a new name instead.
+int File::extractInto(FXWindow* owner, const FXString& archive, const FXString& dir)
+{
+    if (!xf_iswritable(dir))
+    {
+        MessageBox::error(owner, BOX_OK, _("Error"), _("Can't write to %s: Permission denied"), dir.text());
+        return 0;
+    }
+    if (!xf_checkextractspace(owner, archive, dir))
+    {
+        return 0;
+    }
+
+    FXString base = xf_archivebasename(archive);
+    FXString target = FXPath::absolute(dir, base);
+    for (int i = 2; xf_existfile(target); i++)
+    {
+        target = FXPath::absolute(dir, base + " (" + FXStringVal(i) + ")");
+    }
+
+    FXbool single = xf_extractcommand(archive, "").find(" -dc ") >= 0;
+    FXString cmd = xf_extractcommand(archive, FXPath::name(target));
+    if (cmd.empty())
+    {
+        MessageBox::error(owner, BOX_OK, _("Error"),
+                          _("No program to extract %s was found.\n\n"
+                            "Install 7-Zip (7z) or libarchive (bsdtar) using your distribution's software manager."),
+                          FXPath::name(archive).text());
+        return 0;
+    }
+
+    FXString workdir = dir;
+    if (!single)
+    {
+        if (::mkdir(target.text(), 0777) != 0)
+        {
+            MessageBox::error(owner, BOX_OK, _("Error"), _("Can't create folder %s: %s"), target.text(),
+                              strerror(errno));
+            return 0;
+        }
+        workdir = target;
+    }
+
+    File* f = new File(owner, _("Extract Archive"), EXTRACT);
+    f->create();
+    int ret = f->extract(xf_quote(archive), workdir, cmd);
+    delete f;
+    return ret;
+}

+// Warn and return false when the folder doesn't have enough free space to extract the archive
+FXbool xf_checkextractspace(FXWindow* owner, const FXString& archive, const FXString& dir)
+{
+    FXulong needed;
+    FXbool exact;
+    struct statvfs vfs;
+    if (!xf_archiveunpackedsize(archive, needed, exact) || statvfs(dir.text(), &vfs) != 0)
+    {
+        return true;
+    }
+    FXulong available = (FXulong)vfs.f_frsize * vfs.f_bavail;
+    if (needed <= available && xf_reservespace(dir, needed) != 0)
+    {
+        return true;
+    }
+    if (needed <= available)
+    {
+        MessageBox::error(owner, BOX_OK, _("Not Enough Disk Space"),
+                          _("%s can't be extracted in %s.\n\nThe disk reports %s free, but refused to set aside "
+                            "the %s needed (disk quota or space reserved by the file system).\n\n"
+                            "Nothing was extracted. Free up some space or choose another destination."),
+                          FXPath::name(archive).text(), dir.text(),
+                          xf_humansize(FXStringVal(available).text()).text(),
+                          xf_humansize(FXStringVal(needed).text()).text());
+        return false;
+    }
+    FXString hneeded = xf_humansize(FXStringVal(needed).text());
+    FXString havailable = xf_humansize(FXStringVal(available).text());
+    if (exact)
+    {
+        MessageBox::error(owner, BOX_OK, _("Not Enough Disk Space"),
+                          _("There is not enough free space to extract %s.\n\nNeeded: %s\nFree in %s: %s\n\n"
+                            "Nothing was extracted. Free up some space or choose another destination."),
+                          FXPath::name(archive).text(), hneeded.text(), dir.text(), havailable.text());
+    }
+    else
+    {
+        MessageBox::error(owner, BOX_OK, _("Not Enough Disk Space"),
+                          _("There is not enough free space to extract %s.\n\nNeeded: at least %s\nFree in %s: %s\n\n"
+                            "Nothing was extracted. Free up some space or choose another destination."),
+                          FXPath::name(archive).text(), hneeded.text(), dir.text(), havailable.text());
+    }
+    return false;
+}

#!/bin/bash
set -euo pipefail

relative_output=${1:?Output path under build/ is required}
source_root=/source
source_copy=/tmp/swordfish-source
output_dir="/output/$relative_output"

case "$relative_output" in
    ""|/*|..|../*|*/../*)
        printf 'Unsafe output path: %s\n' "$relative_output" >&2
        exit 1
        ;;
esac

glibc_version=$(getconf GNU_LIBC_VERSION)

mkdir -p "$source_copy" "$(dirname -- "$output_dir")" "$HOME"
tar -C "$source_root" \
    --exclude=.git \
    --exclude=build \
    --exclude=zip \
    --exclude='*.zip' \
    -cf - . | tar -C "$source_copy" -xf -

linuxdeploy_appimage=/tmp/linuxdeploy-x86_64.AppImage
linuxdeploy_dir=/tmp/linuxdeploy
curl --fail --location --retry 3 \
    --output "$linuxdeploy_appimage" \
    https://github.com/linuxdeploy/linuxdeploy/releases/download/1-alpha-20251107-1/linuxdeploy-x86_64.AppImage
chmod 755 "$linuxdeploy_appimage"
printf '%s  %s\n' \
    c20cd71e3a4e3b80c3483cef793cda3f4e990aca14014d23c544ca3ce1270b4d \
    "$linuxdeploy_appimage" | sha256sum --check
mkdir -p "$linuxdeploy_dir"
(cd "$linuxdeploy_dir" && "$linuxdeploy_appimage" --appimage-extract >/dev/null)
linuxdeploy="$linuxdeploy_dir/squashfs-root/AppRun"

# Distribution LibRaw packages on older bases predate CR3 and recent cameras.
libraw_version=0.21.5
libraw_tarball=/tmp/LibRaw-$libraw_version.tar.gz
curl --fail --location --retry 3 \
    --output "$libraw_tarball" \
    "https://www.libraw.org/data/LibRaw-$libraw_version.tar.gz"
printf '%s  %s\n' \
    a74a2e68303d3b9219f82318f935b28c5c4abd7f2c9f7dbf8faa4997c9038305 \
    "$libraw_tarball" | sha256sum --check
tar -C /tmp -xzf "$libraw_tarball"
# The container runs unprivileged, so install into a private prefix.
libraw_prefix=/tmp/libraw-prefix
(cd "/tmp/LibRaw-$libraw_version" \
    && ./configure --prefix="$libraw_prefix" --disable-examples --disable-openmp \
        --disable-jasper --disable-static \
    && make -j"${JOBS:-1}" \
    && make install)
export PKG_CONFIG_PATH="$libraw_prefix/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
export LD_LIBRARY_PATH="$libraw_prefix/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

cd "$source_copy"
# Never reuse objects compiled on the host: they may need a newer glibc.
find . \( -name '*.o' -o -name '*.a' -o -name '.dirstamp' \) -type f -delete
find . -name '.deps' -type d -prune -exec rm -rf {} +
rm -f src/swordfish src/swfa src/swfi src/swfp src/swfw config.status config.cache
# Older bases ship an older gettext; match the requested version to it.
gettext_version=$(gettext --version | sed -n '1s/.* \([0-9]*\.[0-9]*\(\.[0-9]*\)\{0,1\}\).*$/\1/p')
sed -i "s/^AM_GNU_GETTEXT_VERSION(\[[0-9.]*\])/AM_GNU_GETTEXT_VERSION([$gettext_version])/" configure.ac
autoreconf -fi
./configure --prefix=/usr
make -j"${JOBS:-1}"

rm -rf -- "$output_dir"
mkdir -p "$output_dir"
DESTDIR="$output_dir" make install

deploy_args=(--appdir "$output_dir")
for program in swordfish swfa swfi swfp swfw swordfish-preview swordfish-network xfe-automount; do
    executable="$output_dir/usr/bin/$program"
    if [ ! -x "$executable" ]; then
        printf 'Expected installed program is missing: %s\n' "$executable" >&2
        exit 1
    fi
    deploy_args+=(--executable "$executable")
done

# SVG converter used to turn system icon themes into Swordfish icons
rsvg_convert=$(command -v rsvg-convert)
if [ -z "$rsvg_convert" ]; then
    printf 'rsvg-convert is required to bundle the icon converter\n' >&2
    exit 1
fi
deploy_args+=(--executable "$rsvg_convert")
deploy_args+=(--executable "$(command -v unzip)")
deploy_args+=(--executable "$(command -v ffmpegthumbnailer)")

pixbuf_moduledir=$(pkg-config --variable=gdk_pixbuf_moduledir gdk-pixbuf-2.0)
pixbuf_query=$(find /usr/lib -type f -name gdk-pixbuf-query-loaders -print -quit)
if [ -z "$pixbuf_query" ]; then
    printf 'gdk-pixbuf-query-loaders is required to bundle image loaders\n' >&2
    exit 1
fi
deploy_args+=(--executable "$pixbuf_query")
mkdir -p "$output_dir/usr/lib/swordfish/pixbuf-loaders"
mkdir -p "$output_dir/usr/lib/swordfish/gio-modules"
for loader in "$pixbuf_moduledir"/*.so; do
    install -m 755 "$loader" "$output_dir/usr/lib/swordfish/pixbuf-loaders/"
    deploy_args+=(--library "$loader")
done

desktop_file="$output_dir/usr/share/applications/swordfish.desktop"
if [ ! -f "$desktop_file" ]; then
    printf 'Expected desktop file is missing: %s\n' "$desktop_file" >&2
    exit 1
fi
deploy_args+=(--desktop-file "$desktop_file")
"$linuxdeploy" "${deploy_args[@]}"
# Discovery and remote listings must load host GIO/GVFS, not bundled GIO via
# linuxdeploy's RUNPATH. Restore the unmodified, baseline-built helper.
install -m 755 src/swordfish-network "$output_dir/usr/bin/swordfish-network"
mkdir -p "$output_dir/usr/share/mime"
cp -a /usr/share/mime/. "$output_dir/usr/share/mime/"

# Keep the original Xfe executable names working for saved settings and
# file associations, while using the Swordfish names as the packaged programs.
ln -s swfa "$output_dir/usr/bin/xfa"
ln -s swfi "$output_dir/usr/bin/xfi"
ln -s swfp "$output_dir/usr/bin/xfp"
ln -s swfw "$output_dir/usr/bin/xfw"

# Bundle the generic GLVND dispatch libraries, but leave graphics drivers to
# the host so OpenGL continues to use the target system's driver stack.
mkdir -p "$output_dir/usr/lib"
for library in libOpenGL.so.0 libGLdispatch.so.0; do
    library_path=$(ldconfig -p | awk -v name="$library" '$1 == name { print $NF; exit }')
    if [ -z "$library_path" ] || [ ! -f "$library_path" ]; then
        printf 'Required OpenGL runtime library is unavailable: %s\n' "$library" >&2
        exit 1
    fi
    install -m 755 "$library_path" "$output_dir/usr/lib/$library"
done

install -m 755 portable/AppRun "$output_dir/AppRun"
install -m 644 portable/README.md "$output_dir/README.md"
mkdir -p "$output_dir/usr/share/doc/swordfish"
install -m 644 COPYING "$output_dir/usr/share/doc/swordfish/COPYING"
mkdir -p "$output_dir/usr/share/doc/unzip"
install -m 644 /usr/share/doc/unzip/copyright "$output_dir/usr/share/doc/unzip/copyright"
# Include notices for dynamically loaded modules and transitive decoder libraries too.
dpkg-query -W -f='${binary:Package}\t${Version}\n' > "$output_dir/usr/share/doc/swordfish/build-packages.txt"
for notice in /usr/share/doc/*/copyright; do
    package=$(basename "$(dirname "$notice")")
    mkdir -p "$output_dir/usr/share/doc/$package"
    cp -L "$notice" "$output_dir/usr/share/doc/$package/copyright"
done
cp -a /usr/share/common-licenses "$output_dir/usr/share/"
mkdir -p "$output_dir/usr/share/doc/libraw"
for notice in COPYRIGHT LICENSE.LGPL LICENSE.CDDL; do
    install -m 644 "/tmp/LibRaw-$libraw_version/$notice" "$output_dir/usr/share/doc/libraw/$notice"
done
for program in swfa swfi swfp swfw; do
    ln -s AppRun "$output_dir/run-$program"
done

for directory in config data cache state scripts themes icons addons; do
    mkdir -p "$output_dir/portable-data/$directory"
done

printf 'Built portable folder against %s (%s) at %s\n' "$(. /etc/os-release; printf '%s' "$PRETTY_NAME")" "$glibc_version" "$output_dir"
